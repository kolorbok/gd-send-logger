{
  "geode": "5.6.1",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "id": "kolorbok.gd-send-logger",
  "name": "GD Requests",
  "version": "v2.0.20",
  "developer": "kolorbok",
  "description": "",
  "settings": {
    "enabled": {
      "type": "bool",
      "name": "Send Logging",
      "default": true
    },
    "connection-key": {
      "type": "string",
      "name": "Connection Key",
      "default": "",
      "filter": "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    },
    "test-send": {
      "type": "bool",
      "name": "Test Connection",
      "default": false
    },
    "debug-logging": {
      "type": "bool",
      "name": "Debug Logging",
      "default": false
    }
  },
  "dependencies": {
    "bitz.fakegdmod": {
      "version": ">=v1.0.0",
      "required": false
    },
    "geode.node-ids": ">=v1.22.0"
  }
}
