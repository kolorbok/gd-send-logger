{
  "geode": "5.6.1",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "id": "kolorbok.gd-requests",
  "name": "GD Requests",
  "version": "v1.0.0",
  "developer": "kolorbok",
  "description": "Connects Geometry Dash with GD Requests on Discord. View server requests, submit request results, and log Geometry Dash sends directly from the game.",
  "settings": {
    "enabled": {
      "type": "bool",
      "name": "Send Logging",
      "default": true
    },
    "connection-key": {
      "type": "string",
      "name": "GD Requests Key",
      "default": "",
      "filter": "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    },
    "logger-key": {
      "type": "string",
      "name": "GD Send Logger Key",
      "default": "",
      "filter": "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    },
    "test-send": {
      "type": "bool",
      "name": "Test Connection",
      "default": false
    },
    "debug-logging": {
      "type": "bool",
      "name": "Debug Logging",
      "default": false
    }
  },
  "dependencies": {
    "bitz.fakegdmod": {
      "version": ">=v1.0.0",
      "required": false
    },
    "geode.node-ids": ">=v1.22.0"
  },
  "resources": {
    "files": [
      "resources/request-star.png",
      "resources/request-rejected.png"
    ]
  }
}
